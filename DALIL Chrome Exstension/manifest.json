{
  "manifest_version": 3,
  "name": "دليل (DALIL) | مستخرج البيانات المكانية لخرائط جوجل",
  "version": "2.1.0",
  "description": "منصة دليل (DALIL) - اكتشاف وجمع معلومات المواقع وسجلات الأماكن (Discovery and Acquisition of Location Information & Listings) للمسح الجغرافي واستخراج إحداثيات X و Y إلى إكسيل و GIS.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://*.google.com/maps*",
    "https://maps.google.com/*",
    "https://*.google.com/search*",
    "https://*.tile.openstreetmap.org/*",
    "https://server.arcgisonline.com/*",
    "https://overpass-api.de/api/interpreter"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.google.com/maps*",
        "https://maps.google.com/*",
        "https://*.google.com/search*"
      ],
      "js": ["lib/spatial-utils.js", "core/search-navigation.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
